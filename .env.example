# Copie para .env e preencha. O .env nunca vai para o GitHub.

# Chave da API Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Conta de serviço do Firebase (Console > Configurações do projeto > Contas de serviço).
# Local: caminho do arquivo. Vercel: cole o JSON inteiro em uma linha.
FIREBASE_SERVICE_ACCOUNT=service-account.json
FIREBASE_PROJECT_ID=studytimeia

# Pasta raiz dos dados no Firestore (mesma do site antigo — não mude, senão os dados somem da tela)
APP_ID=concursa-ia-local-app

# Endereços do front-end (est-web) que podem chamar a API, separados por vírgula
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Upgrade para Premium sem pagamento (simulação). Use false quando houver pagamento real.
ALLOW_FAKE_UPGRADE=true
APP_TIMEZONE=America/Sao_Paulo
